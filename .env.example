# Senha do sa: 8+ caracteres com maiúscula, minúscula, número e símbolo; senão o container não sobe.
MSSQL_SA_PASSWORD=Troque#Esta2026

# Collation do servidor (bancos novos herdam, salvo COLLATE no CREATE DATABASE).
MSSQL_COLLATION=Latin1_General_100_CI_AS_SC

# Developer é gratuita e completa, só para desenvolvimento. Express: MSSQL_PID=Express.
MSSQL_PID=Developer
MSSQL_VERSION=2022-latest
MSSQL_PORT=1433
# Interface publicada: só a própria máquina. Em servidor, acesse por túnel SSH; 0.0.0.0 abre para a rede inteira.
MSSQL_BIND=127.0.0.1
# Com MSSQL_BIND=0.0.0.0 e o firewall/ instalado: IPs de fora liberados, separados por espaço (a rede interna já entra).
MSSQL_ALLOWED_SOURCES=
